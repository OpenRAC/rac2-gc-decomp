
/* 0x1B2FA0 / 0x1B2FA4 are 4-byte small-data objects (gp = 0x1AEFF0, offsets
   +0x3FB0 / +0x3FB4).  The retail addresses them absolutely in every normal
   reference and through $gp in the branch delay slot the reorg pass fills; the
   plain declarations give exactly that split. */
extern int @@EXTERNAL_001B2FA0_00@@ __attribute__((sda));
extern int @@EXTERNAL_001B2FA4_00@@ __attribute__((sda));

extern void @@EXTERNAL_0011A950_00@@(int, int);
extern void @@EXTERNAL_0011B658_00@@(int);

void @@FUNCTION@@(void)
{
    if ((*(volatile u32 *)0x1000E010 & 0x20000) != 0) {
        *(volatile u32 *)0x1000E010 = 0x20000;
    }
    @@EXTERNAL_0011A950_01@@(1, @@EXTERNAL_001B2FA0_01@@);
    @@EXTERNAL_0011A950_02@@(15, @@EXTERNAL_001B2FA4_01@@);
    @@EXTERNAL_0011B658_01@@(1);
    @@EXTERNAL_001B2FA0_02@@ = 0;
    @@EXTERNAL_001B2FA4_02@@ = 0;
}
