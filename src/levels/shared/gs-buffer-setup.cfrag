
/* Scalar GS setup wrapper; pinned standard integer arguments and helper calls. */
extern void @@FOUR_WORDS_0@@(int width, int height, int address, int mode);
extern void @@GS32_64_0@@(unsigned int reg, unsigned long value);
extern void @@TWO_WORDS_0@@(int width, int height);

void @@FUNCTION_0@@(int width, int height)
{
    int sum = width + height;
    int address;

    if (sum > 16)
        sum = 16;
    address = 0x3ff000 - (4 << sum);
    address = (address >> 13) << 13;
    @@FOUR_WORDS_1@@(width, height, address, 1);
    @@GS32_64_1@@(0x47, 0x30000UL);
    @@GS32_64_2@@(0x42, 0x8000000044UL);
    @@TWO_WORDS_1@@(0x100, 0x100);
    @@GS32_64_3@@(0x42, 0x8000000044UL);
}
