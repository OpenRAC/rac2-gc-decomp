
/* Select one of three measured pointer slots for the requested kind. */
extern void *@@PRIMARY_0@@@@PRIMARY_ATTRIBUTE@@;
extern void *@@SECONDARY_0@@@@SECONDARY_ATTRIBUTE@@;
extern void *@@TERTIARY_0@@@@TERTIARY_ATTRIBUTE@@;
void *@@FUNCTION_0@@(int kind)
{
    if (kind == 0 || kind == 2 || kind == 3 || kind == 4 || kind == 5)
        return @@PRIMARY_1@@;
    if (kind == 1)
        return @@SECONDARY_1@@;
    if (kind == 6)
        return @@TERTIARY_1@@;
    return 0;
}
