} @@TYPE_DECL@@;

s32 @@FUNCTION@@(void)
{
    @@TYPE_LOCAL@@ *root = (@@TYPE_CAST@@ *)@@STATE@@;

    if (root->mode == 17 || root->mode == 18
        || root->kind == 0x67 || root->kind == 0x7f
