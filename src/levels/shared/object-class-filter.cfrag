    s32 mode;
} ClassFilterRoot;

s32 @@FUNCTION_0@@(s32 selection) {
    s32 found = 0;
    ClassFilterObject *primary = ((ClassFilterRoot *)@@DATA_0@@)->primary;
    ClassFilterObject *fallback = ((ClassFilterRoot *)@@DATA_1@@)->fallback;
    if (((ClassFilterRoot *)@@DATA_2@@)->mode == 0x31) {
        if (primary) {
            switch (selection) {
                case 0: found = primary->class_id == 0xfbf; break;
                case 1: found = primary->class_id == 0x905; break;
                case 2: found = primary->class_id == 0xeef; break;
            }
        } else if (fallback && selection == 3) {
            found = fallback->class_id == 0xc20;
        }
    }
    return found;
}
